# FalkorDB connection (defaults to localhost:6379). Use FALKORDB_URL for FalkorDB Cloud.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_URL=falkor://default:<password>@<host>:<port>

# Optional: LLM mode. Without a key the agent runs in offline mode (deterministic routing).
# ANTHROPIC_API_KEY=
# TRACEWISE_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint works too (OpenRouter, OpenAI, Groq, Ollama).
# These TRACEWISE_* names take precedence over OPENAI_API_KEY / OPENAI_BASE_URL.
# TRACEWISE_API_KEY=sk-or-v1-...
# TRACEWISE_BASE_URL=https://openrouter.ai/api/v1
# TRACEWISE_MODEL=openai/gpt-4.1-mini

# Force offline mode even if LLM keys are present: TRACEWISE_MODE=offline
